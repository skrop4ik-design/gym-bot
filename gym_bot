def get_user(uid):
    return DB.execute("SELECT bw, sessions FROM users WHERE id=?", (uid,)).fetchone()


def set_w(uid, ex, w, fails=0, cal=None):
    """cal: 1 — вес подтверждён пользователем, 0 — оценка, None — не менять."""
    DB.execute("INSERT INTO weights(uid,ex,w,fails,cal) VALUES(?,?,?,?,COALESCE(?,0)) "
               "ON CONFLICT(uid,ex) DO UPDATE SET w=excluded.w, fails=excluded.fails, "
               "cal=COALESCE(?, cal)", (uid, ex, w, fails, cal, cal))
    DB.commit()


def get_w(uid, ex):
    r = DB.execute("SELECT w, fails FROM weights WHERE uid=? AND ex=?", (uid, ex)).fetchone()
    if r is None:  # новое упражнение у существующего пользователя: оценка, потом уточним
        u = DB.execute("SELECT bw FROM users WHERE id=?", (uid,)).fetchone()
        w = start_weight(ex, u[0] if u else 75, 0.85)
        set_w(uid, ex, w, 0, 0)
        return (w, 0)
    return r


def get_cal(uid, ex):
    r = DB.execute("SELECT cal FROM weights WHERE uid=? AND ex=?", (uid, ex)).fetchone()
    return bool(r and r[0])


def phase(sessions):
    """день цикла (0..3), номер недели, разгрузочная ли неделя (каждая 6-я)."""
    week = sessions // 4 + 1
    return sessions % 4, week, week % 6 == 0


