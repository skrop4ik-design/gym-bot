class SQLiteStorage(BaseStorage):
    """Состояние диалога хранится в gym.db: тренировка не теряется при перезапуске бота."""

    @staticmethod
    def _k(key):
        return f"{key.chat_id}:{key.user_id}"

    async def set_state(self, key, state=None):
        st = state.state if isinstance(state, State) else state
        DB.execute("INSERT INTO fsm(k,state) VALUES(?,?) "
                   "ON CONFLICT(k) DO UPDATE SET state=excluded.state", (self._k(key), st))
        DB.commit()

    async def get_state(self, key):
        r = DB.execute("SELECT state FROM fsm WHERE k=?", (self._k(key),)).fetchone()
        return r[0] if r else None

    async def set_data(self, key, data):
        DB.execute("INSERT INTO fsm(k,data) VALUES(?,?) "
                   "ON CONFLICT(k) DO UPDATE SET data=excluded.data",
                   (self._k(key), json.dumps(data, ensure_ascii=False)))
        DB.commit()

    async def get_data(self, key):
        r = DB.execute("SELECT data FROM fsm WHERE k=?", (self._k(key),)).fetchone()
        return json.loads(r[0]) if r and r[0] else {}

    async def close(self):
        pass


