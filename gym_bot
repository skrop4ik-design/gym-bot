# ----- подходы -----
async def record(msg, state, uid, d, n, edit):
    ex, sets, lo, hi, rest = ex_info(d)
    d["sets"].append([d["w"], n])
    d["s"] += 1
    if d["s"] < d["n"]:
        await state.set_state(Wk.run)
        await state.set_data(d)
        text, markup = set_screen(d)
        return await send(msg, text, markup, edit)
    reps = [r for _, r in d["sets"]]
    w = d["w"]
    DB.execute("INSERT INTO logs(uid,d,ex,w,reps) VALUES(?,?,?,?,?)",
               (uid, date.today().isoformat(), ex, w, " ".join(map(str, reps))))
    DB.commit()
    if d["deload"]:
        note = "🧘 Разгрузка — вес не меняем."
    else:
        _, fails = get_w(uid, ex)
        nw, nf, note = progress(w, fails, reps, sets, lo, hi, EX[ex]["inc"])
        set_w(uid, ex, nw, nf)
    d["summary"].append(f"• {EX[ex]['name']}: {wlabel(ex, w)} × {' '.join(map(str, reps))}")
    d["stage"] = "done"
    text = f"✅ <b>{EX[ex]['name']}</b> — готово!\n{wlabel(ex, w)} × {' '.join(map(str, reps))}\n\n{note}"
    if d["i"] + 1 < n_ex(d):
        text += f"\n\nДальше: {EX[DAYS[d['day']]['ex'][d['i'] + 1][0]]['name']}"
    d["done_text"] = text
    await state.set_state(Wk.run)
    await state.set_data(d)
    await send(msg, text, next_kb(d), edit)


