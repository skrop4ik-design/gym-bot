# ---------- резервная копия базы (только владелец: переменная ADMIN_ID) ----------
def is_admin(uid):
    return bool(os.environ.get("ADMIN_ID")) and str(uid) == os.environ["ADMIN_ID"].strip()


@router.message(Command("backup"))
async def backup(m: Message):
    if not is_admin(m.from_user.id):
        return await m.answer("Команда только для владельца бота (нужна переменная ADMIN_ID).")
    DB.commit()
    path = os.path.join(tempfile.gettempdir(), "gym_backup.db")
    dst = sqlite3.connect(path)
    DB.backup(dst)
    dst.close()
    await m.answer_document(FSInputFile(path, filename=f"gym_backup_{date.today()}.db"),
                            caption="Резервная копия. Чтобы восстановить — отправь этот файл боту "
                                    "с подписью /restore")


@router.message(F.document)
async def restore(m: Message):
    if not (m.caption or "").strip().lower().startswith("/restore"):
        return await m.answer("Чтобы восстановить базу, отправь файл с подписью /restore.")
    if not is_admin(m.from_user.id):
        return await m.answer("Восстановление доступно только владельцу бота.")
    path = os.path.join(tempfile.gettempdir(), "gym_restore.db")
    try:
        await m.bot.download(m.document, destination=path)
        src = sqlite3.connect(path)
        src.execute("SELECT count(*) FROM users")  # проверка, что это наша база
        src.backup(DB)
        src.close()
    except Exception as e:
        return await m.answer(f"Не получилось восстановить: {e}")
    await m.answer("✅ База восстановлена.")


