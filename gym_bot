def ex_info(d):
    return DAYS[d["day"]]["ex"][d["i"]]


def n_ex(d):
    return len(DAYS[d["day"]]["ex"])


def target(uid, ex, sets, deload):
    w, _ = get_w(uid, ex)
    if deload:
        w, sets = round_to(w * 0.9, EX[ex]["inc"]), max(2, sets - 1)
    return w, sets


def set_screen(d, prefix=""):
    ex, sets, lo, hi, rest = ex_info(d)
    done = "".join(f"✔ Подход {k + 1}: {wlabel(ex, w)} × {r}\n" for k, (w, r) in enumerate(d["sets"]))
    text = (f"{prefix}<b>{d['i'] + 1}/{n_ex(d)} · {name_note(ex)}</b>\n"
            f"План: {d['n']} × {lo}–{hi} повторов · отдых {rest}\n")
    if d["s"] == 0:
        prev = last_result(d["uid"], ex)
        text += (prev + "\n" if prev else "")
    text += (f"\n{done}\n👉 <b>Подход {d['s'] + 1} из {d['n']}</b> — вес <b>{wlabel(ex, d['w'])}</b>\n"
             "Сколько повторов сделал? Нажми число")
    if d["s"] == 0:
        text += "\n💡 Оставляй в запасе 1–2 повтора."
    a = max(1, lo - 2)
    nums = list(range(a, min(hi + 2, a + 11) + 1))
    rows = [[(str(n), f"r:{n}") for n in nums[k:k + 4]] for k in range(0, len(nums), 4)]
    rows.append([("⚖️ Изменить вес", "wt"), ("⏭ Пропустить упр.", "skip")])
    if d["s"] > 0:
        rows.append([("↩️ Отменить последний подход", "undo")])
    return text, kb(*rows)


def next_kb(d):
    last = d["i"] + 1 >= n_ex(d)
    return kb([("🏁 Завершить тренировку" if last else "➡️ Дальше", "next")])


async def begin_exercise(msg, state, uid, d, edit=False, prefix=""):
    ex, sets, lo, hi, rest = ex_info(d)
    if not get_cal(uid, ex):
        w = get_w(uid, ex)[0]
        d["stage"] = "cal"
        await state.set_state(Wk.cal)
        await state.set_data(d)
        how = ("Напиши доп. вес в кг (<code>0</code> — без веса)."
               if EX[ex]["k"] == 0 else
               "• нажми «Взять» ИЛИ напиши свой рабочий вес: <code>60</code>\n"
               "• либо лучший подход: <code>60 10</code> (60 кг × 10) — тогда я рассчитаю вес сам")
        text = (f"{prefix}<b>{d['i'] + 1}/{n_ex(d)} · {name_note(ex)}</b>\n"
                "Первый раз в этом упражнении — определим рабочий вес.\n\n"
                f"Предлагаю: <b>{wlabel(ex, w)}</b>\n\n{how}")
        return await send(msg, text, kb([(f"✅ Взять {wlabel(ex, w)}", "calok")],
                                        [("⏭ Пропустить упражнение", "skip")]), edit)
    w, n = target(uid, ex, sets, d["deload"])
    d.update(stage="set", w=w, n=n, s=0, sets=[])
    await state.set_state(Wk.run)
    await state.set_data(d)
    text, markup = set_screen(d, prefix)
    await send(msg, text, markup, edit)


async def go_next(msg, state, uid, d, edit=False, prefix=""):
    if d["i"] + 1 >= n_ex(d):
        DB.execute("UPDATE users SET sessions = sessions + 1 WHERE id=?", (uid,))
        DB.commit()
        await state.clear()
        try:
            await msg.edit_reply_markup(reply_markup=None)
        except Exception:
            pass
        return await msg.answer(
            prefix + "🔥 <b>Тренировка завершена!</b>\n\n" + "\n".join(d["summary"]) +
            "\n\nОтдыхай, ешь белок (~1,6–2 г на кг массы тела) и хорошо спи. "
            "Следующая тренировка — кнопка «🏋️ Тренировка».", reply_markup=MENU)
    d["i"] += 1
    await begin_exercise(msg, state, uid, d, edit, prefix)


