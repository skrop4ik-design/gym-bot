    await state.set_data({"k": float(c.data[4:])})
    await c.message.answer("<b>Шаг 1.</b> Напиши свою массу тела в кг, например <code>78</code>")
    await c.answer()


@router.message(Onb.bw)
async def bodyweight(m: Message, state: FSMContext):
    try:
        bw = float((m.text or "").replace(",", "."))
        assert 30 <= bw <= 250
    except Exception:
        return await m.answer("Напиши число, например <code>78</code>")
    k = (await state.get_data())["k"]
    uid = m.from_user.id
    DB.execute("INSERT OR REPLACE INTO users VALUES(?,?,0)", (uid, bw))
    for ex in EX:
        set_w(uid, ex, start_weight(ex, bw, k), 0, 0)  # запасная оценка
    await state.set_state(Onb.key)
    await state.set_data(dict(k=k, bw=bw, i=0, ratios=[]))
    await m.answer("<b>Шаг 2.</b> Теперь твои веса в 6 базовых упражнениях. По ним я прикину "
                   "остальные, а новые упражнения уточню прямо в тренировке.")
    await m.answer(key_prompt(0), reply_markup=SKIP_KB)


def key_prompt(i):
    return (f"<b>Вопрос {i + 1} из {len(KEY)} · {name_note(KEY[i])}</b>\n"
            "Напиши вес и повторы твоего лучшего недавнего подхода (до отказа или близко).\n"
            "Пример: <code>80 8</code> — это 80 кг на 8 повторов.\n"
            "Если не делаешь это упражнение — нажми кнопку ниже.")


async def key_step(msg, state, uid, wr):
    d = await state.get_data()
    i, ratios, ex = d["i"], d["ratios"], KEY[d["i"]]
    if wr:
        w = to_working(ex, *wr)
        set_w(uid, ex, w, 0, 1)
        if EX[ex]["k"] > 0 and w > 0:
            ratios.append(w / (d["bw"] * EX[ex]["k"]))
    i += 1
    if i < len(KEY):
        await state.update_data(i=i, ratios=ratios)
        return await msg.answer(key_prompt(i), reply_markup=SKIP_KB)
    ratio = sum(ratios) / len(ratios) if ratios else d["k"]
    for e in EX:  # остальные упражнения — по массе тела × твой коэффициент силы
        if not get_cal(uid, e):
            set_w(uid, e, max(0.0, round_to(d["bw"] * EX[e]["k"] * ratio, EX[e]["inc"])), 0, 0)
    await state.clear()
    await msg.answer("✅ <b>Готово!</b> Рабочие веса рассчитаны.\n\n"
                     "Нажми «🏋️ Тренировка» внизу, чтобы начать. Перед упражнениями делай 2–3 "
                     "разминочных подхода с лёгким весом.", reply_markup=MENU)


