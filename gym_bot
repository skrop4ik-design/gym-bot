def fmt(w: float) -> str:
    return f"{w:g}"


def round_to(x: float, step: float) -> float:
    return round(round(x / step) * step, 2)


def start_weight(ex: str, bodyweight: float, level_k: float) -> float:
    e = EX[ex]
    return max(0.0, round_to(bodyweight * e["k"] * level_k, e["inc"]))


def one_rm(weight: float, reps: int) -> float:
    """Формула Эпли."""
    return weight * (1 + reps / 30) if reps > 1 else weight


def working_weight(rm: float, reps: int, rir: int = 2) -> float:
    """Вес для подхода на `reps` повторов с запасом `rir` повторов."""
    return rm / (1 + (reps + rir) / 30)


def progress(w, fails, reps, sets, lo, hi, inc):
    """Двойная прогрессия. Возвращает (новый вес, счётчик провалов, сообщение)."""
    full = len(reps) >= sets
    if full and min(reps) >= hi:
        nw = w + inc
        return nw, 0, f"✅ Во всех подходах верх диапазона → в следующий раз {fmt(nw)} кг"
    if (not full) or min(reps) < lo:
        fails += 1
        if fails >= 2:
            nw = max(0.0, round_to(w * 0.9, inc))
            return nw, 0, f"🔻 Два провала подряд → откат до {fmt(nw)} кг (−10%), наберём заново"
        return w, fails, "⚠️ Не добрал нижнюю границу повторов. Вес оставляем; повторится — откат −10%"
    return w, 0, f"👍 Вес {fmt(w)} кг держим. Цель — добрать до {hi} повторов во всех подходах"


# id -> (подходов, повторы от, повторы до)
RANGE = {ex: (s, lo, hi) for d in DAYS for ex, s, lo, hi, _ in d["ex"]}


def calibrated_weight(ex: str, w: float, reps: int) -> float:
    """Рабочий вес из твоего лучшего подхода (вес × повторы, близко к отказу).
    Берём вес на (низ диапазона + 1) повтор с запасом 2 повтора."""
    e = EX[ex]
    if e["k"] == 0:  # свой вес: берём введённый доп. вес как есть
        return max(0.0, w)
    _, lo, hi = RANGE[ex]
    return max(0.0, round_to(working_weight(one_rm(w, reps), min(lo + 1, hi)), e["inc"]))


