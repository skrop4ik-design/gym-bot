def parse_input(txt):
    """'60' -> (60.0, None); '60 10' / '60x10' -> (60.0, 10)."""
    t = (txt or "").strip().lower().replace(",", ".")
    mt = re.match(r"^(\d+(?:\.\d+)?)(?:\s*[x×*\s]\s*(\d{1,2}))?$", t)
    if not mt:
        return None
    return float(mt.group(1)), (int(mt.group(2)) if mt.group(2) else None)


def to_working(ex, w, r):
    """Вес + повторы лучшего подхода -> рабочий вес; один вес -> берём как есть."""
    return calibrated_weight(ex, w, r) if r else w


def wlabel(ex, w):
    if EX[ex]["k"] == 0:
        return "своё тело" if w == 0 else f"+{fmt(w)} кг"
    return f"{fmt(w)} кг"


def name_note(ex):
